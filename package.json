{
  "name": "roll-masters",
  "version": "0.0.0",
  "type": "module",
  "description": "Dice Rolling Game",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "lint": "oxlint src vite.config.ts --deny-warnings",
    "lint:fix": "npm run lint -- --fix",
    "build": "tsc && vite build",
    "serve": "vite preview",
    "test:ui": "node scripts/test-unit.mjs --ui",
    "test": "node scripts/test-unit.mjs",
    "test:unit": "node scripts/test-unit.mjs",
    "test:coverage": "node scripts/test-coverage.mjs",
    "test:smoke": "playwright test",
    "test:perf:build": "vite build --mode performance --sourcemap --outDir reports/performance/build",
    "test:perf": "node scripts/test-performance.mjs",
    "test:perf:stress": "node scripts/test-performance.mjs --stress",
    "test:perf:verify": "node scripts/test-performance.mjs --verify",
    "test:perf:compare": "node scripts/compare-performance.mjs",
    "test:perf:report": "playwright show-report reports/performance/html",
    "test:all": "node scripts/test-all.mjs",
    "test:browser:install": "playwright install --only-shell chromium",
    "test:report": "playwright show-report reports/browser/html",
    "test:summary": "node scripts/report-tests.mjs",
    "test:typecheck": "tsc --project tsconfig.testing.json"
  },
  "repository": {},
  "keywords": [
    "excalibur",
    "excaliburjs",
    "vite",
    "game-engine"
  ],
  "author": "",
  "license": "",
  "bugs": {},
  "homepage": "",
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "excalibur": "0.30.3"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "c8": "12.0.0",
    "oxlint": "1.89.0",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
